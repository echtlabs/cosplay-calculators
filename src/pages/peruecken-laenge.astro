---
import Base from '../layouts/Base.astro';
---
<Base title="Perückenlänge: Wo endet eine 60, 80 oder 100 cm Perücke?" desc="Sieh, wo eine Cosplay-Perücke an deinem Körper endet, und finde die passende Länge für Schulter, Taille, Hüfte oder Knie." path="peruecken-laenge/" h1="Cosplay Perücken-Längenguide">
<h1>Perücken-Längenguide</h1>
<p class="lead">Gib deine Körpergröße und die Länge der Perücke ein. Die Grafik zeigt, wo die Spitzen ungefähr enden.</p>
<form id="f" class="card">
<div class="grid">
<label>Deine Körpergröße (cm)<input name="h" inputmode="decimal" value="165"></label>
<label>Länge der Perücke (cm)<input name="l" inputmode="decimal" value="80"></label>
<label>Haarstruktur<select name="s"><option value="0">Glatt</option><option value="0.1">Leicht gewellt (ca. −10 %)</option><option value="0.2">Stark gewellt oder gelockt (ca. −20 %)</option></select></label>
</div>
<input type="range" name="r" min="20" max="150" value="80" aria-label="Perückenlänge einstellen">
</form>
<div class="card"><div id="out" aria-live="polite"></div><svg id="svg" viewBox="0 0 220 320" role="img" aria-label="Körpersilhouette mit Perückenlänge" style="max-width:260px;width:100%;display:block;margin:12px auto 0"></svg></div>
<details><summary>Annahmen und Grenzen</summary><p>Die Höhen der Orientierungspunkte sind Richtwerte nach durchschnittlichen Körperproportionen und gelten für eine gerade stehende Person. Gemessen wird die Perückenlänge vom Scheitel, die Haare fallen gerade nach unten. Wellen verkürzen die sichtbare Länge, die Prozentwerte sind grobe Annahmen und je nach Hersteller verschieden. Prüfe zusätzlich die Messangabe im Shop.</p></details>
</Base>
<script>
import { $, num, f, bind } from '../lib/u.js';
const LM = [['Kinn', 0.87], ['Schulter', 0.818], ['Brust', 0.72], ['Taille', 0.62], ['Hüfte', 0.53], ['Knie', 0.285]];
const F = $('#f'), out = $('#out'), svg = $('#svg');
F.r.addEventListener('input', () => { F.l.value = F.r.value; });
function calc() {
  const H = num(F.h.value), L = num(F.l.value), k = +F.s.value;
  if (!(H > 100 && H < 230)) { out.textContent = 'Bitte eine Körpergröße zwischen 100 und 230 cm eingeben.'; return; }
  if (!(L > 0)) { out.textContent = 'Bitte eine Perückenlänge eingeben.'; return; }
  if (L >= 20 && L <= 150) F.r.value = L;
  const Le = L * (1 - k), y = Math.max(0, H - Le), lm = LM.map(([n, r]) => [n, r * H]);
  const near = lm.find(([, h]) => Math.abs(h - y) <= 3);
  let pos;
  if (y <= 3) pos = 'bis zum Boden';
  else if (near) pos = `etwa auf Höhe von ${near[0]}`;
  else if (y > lm[0][1]) pos = 'oberhalb des Kinns';
  else if (y < lm[5][1]) pos = 'unterhalb der Knie';
  else { const i = lm.findIndex(([, h]) => h < y); pos = `zwischen ${lm[i - 1][0]} und ${lm[i][0]}`; }
  out.innerHTML = `<p class="big">${pos}</p><p>Die Spitzen enden ca. ${f(y, 0)} cm über dem Boden${k ? ` (wirksame Länge ${f(Le, 0)} cm)` : ''}.</p><table><tr><th>Ziel</th><th>Höhe</th><th>Nötige Länge</th></tr>${lm.map(([n, h]) => `<tr><td>${n}</td><td>${f(h, 0)} cm</td><td>${f((H - h) / (1 - k), 0)} cm</td></tr>`).join('')}</table>`;
  const Y = (r) => 10 + 300 * (1 - r), fr = y / H, X = 70;
  svg.innerHTML = `<path d="M${X - 30} ${Y(0.818)}H${X + 30}L${X + 22} ${Y(0.62)}L${X + 28} ${Y(0.53)}L${X + 20} ${Y(0)}H${X + 2}L${X} ${Y(0.45)}L${X - 2} ${Y(0)}H${X - 20}L${X - 28} ${Y(0.53)}L${X - 22} ${Y(0.62)}Z" fill="var(--line)"/><ellipse cx="${X}" cy="${Y(0.935)}" rx="14" ry="19.5" fill="var(--line)"/><rect x="${X - 18}" y="${Y(1)}" width="36" height="${Y(fr) - Y(1)}" rx="10" fill="var(--tape)" opacity=".8"/>` + LM.map(([n, r]) => `<line x1="20" x2="120" y1="${Y(r)}" y2="${Y(r)}" stroke="var(--mut)" stroke-dasharray="3 3"/><text x="126" y="${Y(r) + 4}" font-size="11" fill="var(--mut)">${n}</text>`).join('') + `<line x1="30" x2="110" y1="${Y(fr)}" y2="${Y(fr)}" stroke="var(--ink)" stroke-width="2"/><text x="126" y="${Y(fr) + 4}" font-size="12" font-weight="700" fill="var(--ink)"${LM.some(([, r]) => Math.abs(Y(r) - Y(fr)) < 12) ? ' dy="-12"' : ''}>Spitzen</text>`;
}
bind(F, calc);
</script>
